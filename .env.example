# ============================================================
# Twilio Agent Connect payment-reminder demo - environment vars
# Copy to .env and fill in. The TAC setup wizard can generate
# most of these for you (see README "Setup").
# ============================================================

# --- Twilio account credentials ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Twilio number that places the call and sends the SMS
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- TAC Conversations services (created by the TAC setup wizard) ---
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxxxxxxxxxx

# --- Enterprise Knowledge base with the renewal FAQ loaded (see README) ---
TWILIO_KNOWLEDGE_BASE_ID=know_knowledgebase_xxxxxxxxxxxxxxxx

# --- Studio Flow that rings the browser agent (import studio-flow.json) ---
TWILIO_STUDIO_HANDOFF_FLOW_SID=FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Public domain for webhooks + ConversationRelay websocket ---
# e.g. from: ngrok http 8000  ->  abc123.ngrok.app  (no scheme, no trailing slash)
TWILIO_VOICE_PUBLIC_DOMAIN=your-domain.ngrok.app

# --- LLM ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Abuse guard for public deployments (optional) ---
# POST /api/call places a real billed call to whatever number it is given, and
# the demo has no auth. Leave this UNSET for local/ngrok dev (any number works).
# SET it on any publicly reachable deployment: comma-separated E.164, exact
# match, and anything else gets a 403.
# DEMO_ALLOWED_NUMBERS=+15555550100,+15555550101

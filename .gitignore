.env
# Timestamped .env backups hold live credentials too. This repo has no commits
# yet, so without this line the first `git add -A` would commit them.
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
# uv.lock is deliberately NOT ignored: `twl deploy` ships only committed files,
# and the lock pins the TAC git dependency to an exact commit. Without it the
# Pi builds against whatever upstream main is that day — and the KNOWN-ISSUES #1
# workaround depends on 2.2.0's Pydantic return type.
